APP_NAME=Security SuperAgent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
SECURITY_SUPERAGENT_DATA_ROOT=E:/tzb/security-superagent-data

MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ALLOW_EXTERNAL_MODEL_REAL_DATA=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=security-superagent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_ALLOW_REAL_SECURITY_DATA=false

XDR_MODE=mock
XDR_BASE_URL=
XDR_API_KEY=

DATABASE_URL=sqlite:///./data/runtime/security_superagent.sqlite3
LANGGRAPH_CHECKPOINT_DB=./data/runtime/langgraph-checkpoints.sqlite3
CHROMA_PERSIST_DIRECTORY=./knowledge/index
KNOWLEDGE_SOURCE_REGISTRY=./knowledge/sources.json
KNOWLEDGE_CACHE_DIRECTORY=./data/knowledge-cache
FASTEMBED_CACHE_PATH=./data/models/fastembed
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

FRONTEND_ORIGIN=http://localhost:5173

# Local RBAC bootstrap. Set these only in .env; never commit real values.
AUTH_REQUIRED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_HOURS=8
COOKIE_SECURE=false
JOB_HARD_TIMEOUT_SECONDS=120
