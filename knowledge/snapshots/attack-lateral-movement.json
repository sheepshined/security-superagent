    "title": "MITRE ATT&CK T1021.002 - SMB/Windows Admin Shares",
    "source_uri": "https://attack.mitre.org/techniques/T1021/002/",
    "version": "live-2026-07-31",
    "published_at": "2026-05-12T00:00:00+00:00",
